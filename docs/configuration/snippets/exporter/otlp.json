{
  "SimpleOpenTelemetry": {
    "ExporterOptions": {
      "Otlp": {
        "Headers": null,
        "TimeoutMilliseconds": 10000,
        "Endpoint": "http://localhost:4317",
        "Protocol": "Grpc", // or "HttpProtobuf"
        "Compression": "None",
        "UserAgentProductIdentifier": "",
        "ExportProcessorType": "Batch"
      }
    },
    "Trace": {
       "Exporters": [ { "type": "Otlp" } ]
    },
    "Metric": {
       "Exporters": [ { "type": "Otlp" } ]
    },
    "Log": {
       "Exporters": [ { "type": "Otlp" } ]
    }
  }
}