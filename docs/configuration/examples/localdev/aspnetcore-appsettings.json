{
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    }
  },
  "OTEL_SERVICE_NAME": "quickstartsotelapp",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=unknown,deployment.environment.name=dev",
  "SimpleOpenTelemetry": {
    "Trace": {
      "Instrumentations": ["HttpClient", "AspNetCore"],
      "Exporters": [
        {
          "type": "console"
        },
        {
          "Type": "otlp"
        },
        {
          "Type": "otlp",
          "Options": {
            "Endpoint": "http://localhost:6317",
            "Protocol": "grpc" /* sending to Jaeger */
          }
        }
      ],
      "Settings": {
        "SetErrorStatusOnException": true
      }
    },
    "Metric": {
      "Instrumentations": ["HttpClient", "AspNetCore", "Process", "Runtime"],
      "Exporters": [
        {
          "type": "console"
        },
        {
          "type": "otlp"
        }
      ],
      "CustomMeters": ["System.Net.NameResolution"]
    },
    "Log": {
      "Exporters": [
        {
          "type": "console"
        },
        {
          "type": "otlp"
        }
      ],
      "Settings": {
        "IncludeFormattedMessage": true,
        "IncludeScopes": false,
        "ParseStateValues": false
      }
    }
  }
}
