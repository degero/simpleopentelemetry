{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning",
      // Avoid logging Host internal events
      "Microsoft.Extensions.Hosting.Internal.Host": "Warning"
    }
  },
  "UseSqlEfCore": "false",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SimpleOpenTelemetryAspNetCoreExample;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "OTEL_SERVICE_NAME": "aspnetcore-simpleopentelemetry",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=demo-simpleopentelemetry,deployment.environment.name=dev",
  "SimpleOpenTelemetry": {
    "Trace": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore",
        "SqlClient",
        "EFCore"
      ],
      "InstrumentationConfig": {},
      "Exporters": [
        {
          "type": "console"
        },
        {
          "Type": "otlp"
        },
        {
          "Type": "otlp",
          "Options": {
            "Endpoint": "http://localhost:6317",
            "Protocol": "grpc" /* sending to Jaeger */
          }
        }
      ],
      "Extensions": [],
      "Settings": {
        "SetErrorStatusOnException": true
      },
      "Sources": [
        "SimpleOpenTelemetry.Examples.AspNetCore.*"
      ]
    },
    "Metric": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore",
        "Process",
        "Runtime",
        "SqlClient"
      ],
      "Exporters": [
        {
          "type": "console"
        },
        {
          "type": "otlp"
        }
      ],
      "CustomMeters": [
        "System.Net.NameResolution"
      ]
    },
    "Log": {
      "Exporters": [
        {
          "type": "console"
        },
        {
          "type": "otlp"
        }
      ],
      "Settings": {
        "IncludeFormattedMessage": true,
        "IncludeScopes": false,
        "ParseStateValues": false
      }
    },
    "Resource": {
      "Detectors": [
        "assemblyversion",
        "host",
        "container",
        "os",
        "process"
      ]
    }
  }
}
