{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning",
      // Avoid logging lifetime events
      "Microsoft.Hosting.Lifetime": "Warning",
      // Avoid logging Host internal events
      "Microsoft.Extensions.Hosting.Internal.Host": "Warning"
    }
  },
  "UseSqlEfCore": "false",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SimpleOpenTelemetryAspNetCoreExample;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "OTEL_SERVICE_NAME": "aspnetcore-simpleopentelemetry",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=demo-simpleopentelemetry,deployment.environment.name=dev",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "SimpleOpenTelemetry": {
    "Trace": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore"
      ],
      "Exporters": [
        { "type": "console" },
        {
          "Type": "otlp"
        }
      ],
      "Sources": [ "SimpleOpenTelemetry.Examples.AspNetCore.*" ]
    },
    "Metric": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore",
        "Runtime"
      ],
      "Exporters": [
        { "type": "console" },
        { "type": "otlp" }
      ],
      "CustomMeters": [
        "Microsoft.AspNetCore.Hosting",
        "Microsoft.AspNetCore.Server.Kestrel",
        "Microsoft.AspNetCore.MemoryPool",
        "Microsoft.AspNetCore.Routing",
        "Microsoft.AspNetCore.Diagnostics",      
        "System.Runtime",
        "System.Net.Http",
        "System.Net.NameResolution"
      ]
    },
    "Log": {
      "Exporters": [
        { "type": "console" },
        { "type": "otlp" }
      ]
    },
    "Resource": {
      "Detectors": ["assemblyversion"]
    }
  }
}