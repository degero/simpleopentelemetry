<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- NuGet Package Properties -->
    <PackageId>SimpleOpenTelemetry.Exporters.AzureMonitor</PackageId>
    <Version>0.0.1</Version>
    <Authors>Chad Paynter</Authors>
    <Company>Degero</Company>
    <Description>Azure Monitor (Application Insights) exporter plugin for SimpleOpenTelemetry. Enables seamless integration with Azure Application Insights for distributed tracing and monitoring. Configure with connection string or use environment variables for automatic setup in Azure environments.</Description>
    <PackageTags>opentelemetry;telemetry;azure;applicationinsights;azuremonitor;monitoring</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/degero/SimpleOpenTelemetry</RepositoryUrl>
    <PackageProjectUrl>https://github.com/degero/SimpleOpenTelemetry</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Same major.minor compatibility: e.g. all 1.2.x packages work together. Bump when you bump major/minor. -->
    <CoreVersionRange>[0.0.1,1.0.0)</CoreVersionRange>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SimpleOpenTelemetry/SimpleOpenTelemetry.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SimpleOpenTelemetry" Version="$(CoreVersionRange)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.6.0" />
  </ItemGroup>

</Project>