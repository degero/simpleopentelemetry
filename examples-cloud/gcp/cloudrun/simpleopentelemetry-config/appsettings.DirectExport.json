{
  "Logging": {
    "LogLevel": {
      "Default": "Trace", // Switch to Information for PROD
      "Microsoft.AspNetCore": "Warning",
      // Avoid logging lifetime events - Comment out for local dev to detect/ launch browser
      "Microsoft.Hosting.Lifetime": "Warning",
      // Avoid logging Host internal events
      "Microsoft.Extensions.Hosting.Internal.Host": "Warning"
    }
  },
  "OTEL_SERVICE_NAME": "soteltestgcp",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=demo-simpleopentelemetry,deployment.environment.name=development,gcp.project_id=soteltest,service.instance.id=otel-local-dev,cloud.region=us-east1",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "https://telemetry.googleapis.com",
  "GOOGLE_CLOUD_LOG_NAME": "otlp",
  "SimpleOpenTelemetry": {
    "Trace": {
      "Instrumentations": [ "AspNetCore", "HttpClient" ],
      "Sources": [ "soteltestgcp.*" ]
    },
    "Log": {
      "Settings": {
        "IncludeFormattedMessage": "true"
      }
    },
    "Metric": {
      "Instrumentations": [ "AspNetCore", "HttpClient" ]
    },
    "Resource": {
      "Detectors": [ "gcp" ]
    }
  }
}
