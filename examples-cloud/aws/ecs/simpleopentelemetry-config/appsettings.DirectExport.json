{
  "EnableOtelEventListeners": "true",
  "UseOtelCollector": "false",
  "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://xray.us-east-1.amazonaws.com/v1/traces",
  "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "https://monitoring.us-east-1.amazonaws.com/v1/metrics",
  "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://logs.us-east-1.amazonaws.com/v1/logs",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
  "AWS_REGION":"us-east-1",
  "OTEL_SERVICE_NAME": "soteltestaws",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=demo-simpleopentelemetry,deployment.environment.name=dev",
  "AWS_LOG_GROUP_NAME": "/app/soteltestaws/dev",
  "AWS_LOG_STREAM_NAME": "app",
  "SimpleOpenTelemetry": {
    "Trace": {
      "Instrumentations": [ "AWS", "AspNetCore", "HttpClient" ],
      "Extensions": [ "awsxraytraceid" ],
      "Propagators": [ "AWSXray" ],
      "Sources": [ "soteltestaws.*" ]
    },
    "Log": {
      "Options": {
        "IncludeFormattedMessage": "true"
      }
    },
    "Metric": {
      "Instrumentations": [ "AWS", "AspNetCore", "HttpClient" ]
    },
    "Resource": {
      "Detectors": [ "AWS" ]
    }
  }
}