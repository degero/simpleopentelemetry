{
  "OTEL_SERVICE_NAME": "yourappname",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=yourappnamespace,deployment.environment.name=dev",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otlp.nr-data.net:4317",
  "OTEL_EXPORTER_OTLP_HEADERS": "api-key={yourNRkey}",
  "SimpleOpenTelemetry": {
    "Trace": {
      "Instrumentations": [ "AspNetCore", "HttpClient" ],
      "Exporters": [ { "type": "otlp" } ],
      "Sources": [ "yourappnamespace.*" ]
    },
    "Log": {
      "Exporters": [ { "type": "otlp" } ],
      "Settings": {
        "IncludeFormattedMessage": "true"
      }
    },
    "Metric": {
      "Exporters": [ { "type": "otlp" } ],
      "Instrumentations": [ "AspNetCore", "HttpClient" ]
    }
  }
}