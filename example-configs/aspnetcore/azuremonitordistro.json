{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning",
      // Avoid logging lifetime events
      "Microsoft.Hosting.Lifetime": "Warning",
      // Avoid logging Host internal events
      "Microsoft.Extensions.Hosting.Internal.Host": "Warning"
    }
  },
  "APPLICATIONINSIGHTS_STATSBEAT_DISABLED": "true",
  "OTEL_SERVICE_NAME": "yourappname",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=yournamespace,deployment.environment.name=dev",
  "SimpleOpenTelemetry": {
    "Distro": "AzureMonitorAspNetCore",
    "DistroOptions": {
      "Credential": "Azure.Identity.DefaultAzureCredential",
      "SamplingRatio": "1.0",
      "TracesPerSecond": "5.0",
      "Version": "v2_1",
      "StorageDirectory": "c:\\temp\\azureexporter",
      "DisableOfflineStorage": "false",
      "EnableTraceBasedLogsSampler": "true",
      "EnableStandardMetrics": "true",
      "EnablePerformanceCounters": "true"
    }
  }
}
