{
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    }
  },
  "OTEL_SERVICE_NAME": "demo-aspnet-simpleopentelemetry",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=2.0.0,service.namespace=demo-opentelemetry,deployment.environment.name=dev",
  /* This is the default OpenTelemetry setting, here for reference */
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc", /* OpenTelemetry defaults to httpProtobuf */
  "SimpleOpenTelemetry": {
    /* sending all to default (grafana-lgtm instance) OLTP endpoint */
    "Trace": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore"
      ],
      "Exporters": [
        {
          "Type": "otlp"
        }
      ]
    },
    "Metric": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore",
        "Runtime"
      ],
      "Exporters": [
         {
          "Type": "otlp" 
        }
        {
          "Type": "otlp",
          "Endpoint": "http://localhost:6317",
          "Protocol": "grpc" /* sending to Jaeger */
        }
      ]
    },
    "Log": {
      "Exporters": [
        {
          "Type": "otlp"
        }
      ]
    },
    "CustomMeters": [
      "Microsoft.AspNetCore.Hosting",
      "Microsoft.AspNetCore.Server.Kestrel",
      "System.Net.Http",
      "System.Net.NameResolution"
    ],
    "TraceSources": [
      "Azure.*",
      "demo-aspnet-simpleopentelemetry"
    ]
  }
}
