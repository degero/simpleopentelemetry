{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning",
      // Avoid logging lifetime events
      "Microsoft.Hosting.Lifetime": "Warning",
      // Avoid logging Host internal events
      "Microsoft.Extensions.Hosting.Internal.Host": "Warning"
    }
  },
  "OTEL_SERVICE_NAME": "aspnetcore-simpleopentelemetry",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=2.0.0,service.namespace=demo-simpleopentelemetry,deployment.environment.name=dev",
  /* This is the default OpenTelemetry setting, here for reference */
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc", /* OpenTelemetry defaults to httpProtobuf */
  "SimpleOpenTelemetry": {
    /* sending all to default (grafana-lgtm instance) OLTP endpoint */
    "Trace": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore"
      ],
      "Exporters": [
        {
          "Type": "otlp"
        }
      ],
      "Sources": [
        "SimpleOpenTelemetry.Examples.AspNetCore.*"
      ]
    },
    "Metric": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore",
        "Runtime"
      ],
      "Exporters": [
         {
          "Type": "otlp" 
        },
        {
          "Type": "otlp",
          "Options": {
            "Endpoint": "http://localhost:6317",
            "Protocol": "grpc" /* sending to Jaeger */
          }
        }
      ],
      "CustomMeters": [
        "Microsoft.AspNetCore.Hosting",
        "Microsoft.AspNetCore.Server.Kestrel",
        "System.Net.Http",
        "System.Net.NameResolution"
      ]
    },
    "Log": {
      "Exporters": [
        {
          "Type": "otlp"
        }
      ]
    }
  }
}
