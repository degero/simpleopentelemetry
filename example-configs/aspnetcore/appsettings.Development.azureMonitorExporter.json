{
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    }
  },
  "OTEL_SERVICE_NAME": "demo-aspnet-simpleopentelemetry",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=2.0.0,service.namespace=demo-opentelemetry,deployment.environment.name=dev",
  "SimpleOpenTelemetry": {
    "TracingInstrumentations": [
      "HttpClient",
      "AspNetCore"
    ],
    "MetricsInstrumentations": [
      "HttpClient",
      "AspNetCore",
      "Runtime"
    ],
    "CustomMeters": [
      "Microsoft.AspNetCore.Hosting",
      "Microsoft.AspNetCore.Server.Kestrel",
      "System.Net.Http",
      "System.Net.NameResolution"
    ],
    "TraceSources": [
      "Azure.*",
      "demo-aspnet-simpleopentelemetry"
    ],
    "ExporterOptions": {
    /* Setting here applies to all telemetry sets. They can be overridden in the 'Exporters" sections for 
       specific Tracing, Logging and Metrics options  */
      "Azure": { 
        "ConnectionString": "set this in your dotnet user-secrets",
        "tracespersecond": 0.5, /* Here for reference/example only */
        "samplingratio": 0.4
      }
    },
    "Exporters": {
      "Metrics": [
        {
          "type": "azure",
          "options": { // If there are ExporterOptions -> Azure, this will override them
            "connectionstring": "set this in your dotnet user-secrets"
          }
        }
      ],
      "Logging": [
        {
          "type": "azure",
          "options": {
             "connectionstring": "set this in your dotnet user-secrets"
          } 
        }
      ],
      "Tracing": [
        {
          "type": "azure",
          "options": {
            "connectionstring": "set this in your dotnet user-secrets"
          }
        }
      ]
    }
  }
}
