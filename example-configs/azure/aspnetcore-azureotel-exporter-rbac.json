{
  "OTEL_SERVICE_NAME": "yourappname",
  "OTEL_RESOURCE_ATTRIBUTES": "service.version=1.0.0,service.namespace=yournamespace,deployment.environment.name=dev",
  "OTEL_TRACES_SAMPLER":"parentbased_traceidratio",
  "OTEL_TRACES_SAMPLER_ARG":"0.1", 
  "SimpleOpenTelemetry": {
    "BuilderExtensions": [
      { 
        "Type": "AzureMonitorExporter",
        "Options": {
          "Credential": "Azure.Identity.DefaultAzureCredential",
          "ConnectionString": "InstrumentationKey=00000000-0000-0000-0000-000000000000",
          "SamplingRatio": "0.1",
          "EnableTraceBasedLogsSampler": "false"
        }
      }
    ],
    "Trace": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore",
        "SqlClient",
        "EFCore"
      ],
      "Settings": {
        "SetErrorStatusOnException": true
      },
      "Sources": [ "yourappnamespace.*" ]
    },
    "Metric": {
      "Instrumentations": [
        "HttpClient",
        "AspNetCore"
      ]
    },
    "Resource": {
      "Detectors": [ "azure" ]
    }
  }
}
